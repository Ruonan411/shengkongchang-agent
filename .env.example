# 声控场 Agent —— 环境变量模板
# 用法：复制为 .env.local 并填入真实值（cp .env.example .env.local）
# .env.local 已被 .gitignore 忽略，不会进版本库；本文件（.env.example）可入库作为说明。
#
# 变量说明：
#   NEXT_PUBLIC_WORKBUDDY_ENDPOINT         —— WorkBuddy Cloud 应用域名（应用上线后获得）
#   NEXT_PUBLIC_WORKBUDDY_PUBLISHABLE_KEY  —— 应用的公开密钥（publishableKey，可内置前端）

NEXT_PUBLIC_WORKBUDDY_ENDPOINT=https://your-app.app.workbuddy.host
NEXT_PUBLIC_WORKBUDDY_PUBLISHABLE_KEY=wbpk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
